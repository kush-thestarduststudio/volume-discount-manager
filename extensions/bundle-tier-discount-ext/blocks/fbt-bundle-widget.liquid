{% assign config_data = nil %}

{% if shop.metafields.app.bundle_tiers.config.value %}
  {% assign config_data = shop.metafields.app.bundle_tiers.config.value %}
{% elsif shop.metafields['$app:bundle_tiers']['config'].value %}
  {% assign config_data = shop.metafields['$app:bundle_tiers']['config'].value %}
{% elsif shop.metafields.bundle_tiers.config.value %}
  {% assign config_data = shop.metafields.bundle_tiers.config.value %}
{% elsif shop.metafields.app.bundle_tiers.config %}
  {% assign config_data = shop.metafields.app.bundle_tiers.config %}
{% elsif shop.metafields['$app:bundle_tiers']['config'] %}
  {% assign config_data = shop.metafields['$app:bundle_tiers']['config'] %}
{% elsif shop.metafields.bundle_tiers.config %}
  {% assign config_data = shop.metafields.bundle_tiers.config %}
{% endif %}

{% assign current_product_id_str = product.id | append: '' %}
{% assign matched_fbt_rule = nil %}

{% if config_data and config_data.rules %}
  {% for rule in config_data.rules %}
    {% if rule.active and rule.fbtProducts and rule.fbtProducts.size > 0 %}
      {% assign target_str = rule.targetGid | append: '' %}
      {% if target_str contains current_product_id_str %}
        {% assign matched_fbt_rule = rule %}
        {% break %}
      {% endif %}
      {% for comp in rule.fbtProducts %}
        {% assign comp_id_str = comp.productId | append: '' %}
        {% if comp_id_str contains current_product_id_str %}
          {% assign matched_fbt_rule = rule %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if matched_fbt_rule != nil %}{% break %}{% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if matched_fbt_rule != nil and matched_fbt_rule.fbtProducts.size > 0 %}
  {% assign is_fixed_fbt = false %}
  {% if matched_fbt_rule.discountType == 'FIXED_AMOUNT' %}
    {% assign is_fixed_fbt = true %}
    {% assign fbt_val = matched_fbt_rule.discountValue | default: 100 %}
  {% else %}
    {% assign fbt_val = matched_fbt_rule.discountValue | default: matched_fbt_rule.mainDiscountPercent | default: 10 %}
  {% endif %}

  {% assign target_str = matched_fbt_rule.targetGid | append: '' %}
  {% assign is_current_trigger = false %}
  {% if target_str contains current_product_id_str %}
    {% assign is_current_trigger = true %}
  {% endif %}

  {% assign base_variant = product.selected_or_first_available_variant %}
  {% assign base_price = base_variant.price %}
  {% assign main_disc_pct = matched_fbt_rule.mainDiscountPercent | default: 0 %}

  {% assign base_disc_pct = main_disc_pct %}
  {% if is_current_trigger == false %}
    {% for comp in matched_fbt_rule.fbtProducts %}
      {% assign comp_id_str = comp.productId | append: '' %}
      {% if comp_id_str contains current_product_id_str %}
        {% assign base_disc_pct = comp.discountPercent | default: fbt_val %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% assign initial_bundle_original = base_price %}
  {% assign initial_bundle_total = base_price %}

  {% unless is_fixed_fbt %}
    {% if base_disc_pct > 0 %}
      {% assign main_mult = 100 | minus: base_disc_pct %}
      {% assign initial_bundle_total = base_price | times: main_mult | divided_by: 100 %}
    {% endif %}
  {% endunless %}

  {% if is_current_trigger == false and matched_fbt_rule.triggerProduct %}
    {% assign trig = matched_fbt_rule.triggerProduct %}
    {% assign t_price = trig.priceCents | default: 0 %}
    {% assign initial_bundle_original = initial_bundle_original | plus: t_price %}
    {% if is_fixed_fbt %}
      {% assign initial_bundle_total = initial_bundle_total | plus: t_price %}
    {% else %}
      {% assign t_disc = main_disc_pct | default: fbt_val %}
      {% assign t_mult = 100 | minus: t_disc %}
      {% assign t_disc_amt = t_price | times: t_mult | divided_by: 100 %}
      {% assign initial_bundle_total = initial_bundle_total | plus: t_disc_amt %}
    {% endif %}
  {% endif %}

  {% for fbt in matched_fbt_rule.fbtProducts %}
    {% assign fbt_id_str = fbt.productId | append: '' %}
    {% unless fbt_id_str contains current_product_id_str %}
      {% assign f_price = fbt.priceCents | default: 0 %}
      {% assign initial_bundle_original = initial_bundle_original | plus: f_price %}
      {% if is_fixed_fbt %}
        {% assign initial_bundle_total = initial_bundle_total | plus: f_price %}
      {% else %}
        {% assign f_disc = fbt.discountPercent | default: fbt_val %}
        {% assign f_mult = 100 | minus: f_disc %}
        {% assign f_discounted = f_price | times: f_mult | divided_by: 100 %}
        {% assign initial_bundle_total = initial_bundle_total | plus: f_discounted %}
      {% endif %}
    {% endunless %}
  {% endfor %}

  {% if is_fixed_fbt %}
    {% assign initial_savings = fbt_val | times: 100 %}
    {% assign initial_bundle_total = initial_bundle_original | minus: initial_savings %}
    {% if initial_bundle_total < 0 %}{% assign initial_bundle_total = 0 %}{% endif %}
  {% else %}
    {% assign initial_savings = initial_bundle_original | minus: initial_bundle_total %}
  {% endif %}

  {% assign bundle_code = matched_fbt_rule.discountCode %}
  {% if bundle_code == blank %}
    {% assign clean_fbt_slug = matched_fbt_rule.title | remove: 'Volume Tier:' | remove: 'Bundle for:' | strip | slice: 0, 8 | upcase %}
    {% assign bundle_code = 'BUNDLE-' | append: clean_fbt_slug | append: '-' | append: fbt_val | append: 'OFF' %}
  {% endif %}
  {% assign total_items_count = matched_fbt_rule.fbtProducts.size | plus: 1 %}

  <style>
    .bt-fbt-widget {
      margin: 1.5rem 0;
      padding: 1.25rem;
      background: #ffffff;
      border: 1px solid #e1e3e5;
      border-radius: 12px;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #202223;
      box-sizing: border-box;
      width: 100%;
    }
    .bt-fbt-widget * {
      box-sizing: border-box;
    }
    .bt-widget-header {
      margin-bottom: 1rem;
    }
    .bt-widget-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0 0 0.25rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #1a1a1a;
    }
    .bt-widget-subtitle {
      font-size: 0.85rem;
      color: #6d7175;
      margin: 0;
    }
    .bt-fbt-gallery {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
      overflow-x: auto;
      padding: 0.5rem 0;
    }
    .bt-fbt-thumb-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 84px;
      flex-shrink: 0;
      transition: opacity 0.2s;
    }
    .bt-fbt-thumb-wrap {
      width: 80px;
      height: 80px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #d2d5d8;
      background: #f6f6f7;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .bt-fbt-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .bt-fbt-no-img {
      font-size: 0.75rem;
      color: #6d7175;
      text-align: center;
      padding: 4px;
    }
    .bt-fbt-thumb-label {
      font-size: 0.75rem;
      color: #5c5f62;
      margin-top: 4px;
      font-weight: 500;
      text-align: center;
    }
    .bt-fbt-thumb-badge {
      position: absolute;
      top: -6px;
      right: -4px;
      background: #008060;
      color: #ffffff;
      font-size: 0.65rem;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 6px;
      z-index: 2;
    }
    .bt-fbt-plus-icon {
      font-size: 1.4rem;
      font-weight: 700;
      color: #8c9196;
      margin: 0 0.15rem;
    }
    .bt-fbt-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
    }
    .bt-fbt-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.6rem 0.75rem;
      border-radius: 6px;
      background: #fafbfb;
      border: 1px solid #edf0f2;
      cursor: pointer;
      user-select: none;
    }
    .bt-fbt-row.is-base {
      cursor: default;
      background: #f4f6f8;
    }
    .bt-fbt-checkbox {
      accent-color: #008060;
      width: 1.15rem;
      height: 1.15rem;
      cursor: pointer;
      flex-shrink: 0;
    }
    .bt-fbt-check-label {
      flex: 1;
      font-size: 0.85rem;
      color: #202223;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .bt-fbt-save-pill {
      display: inline-block;
      background: #e3f1df;
      color: #008060;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 4px;
    }
    .bt-fbt-row-price {
      font-size: 0.85rem;
      font-weight: 600;
      display: flex;
      gap: 0.35rem;
      align-items: baseline;
      flex-shrink: 0;
    }
    .bt-fbt-price-discounted {
      color: #008060;
    }
    .bt-fbt-price-original {
      color: #8c9196;
      text-decoration: line-through;
      font-size: 0.75rem;
    }
    .bt-fbt-summary-wrap {
      border-top: 1px dashed #e1e3e5;
      padding-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .bt-fbt-total-box {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      padding: 0.6rem 0.85rem;
      background: #f6fbf9;
      border: 1px solid #cce8de;
      border-radius: 8px;
    }
    .bt-fbt-total-label {
      font-size: 0.95rem;
      font-weight: 600;
      color: #202223;
    }
    .bt-fbt-pricing {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
    }
    .bt-fbt-bundle-price {
      font-size: 1.25rem;
      font-weight: 700;
      color: #008060;
    }
    .bt-fbt-bundle-compare {
      font-size: 0.9rem;
      color: #8c9196;
      text-decoration: line-through;
    }
    .bt-fbt-add-btn {
      width: 100%;
      padding: 0.9rem 1.25rem;
      background: #008060;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.1s ease;
    }
    .bt-fbt-add-btn:hover {
      background: #006e52;
    }
    .bt-fbt-add-btn:active {
      transform: scale(0.99);
    }
    .bt-fbt-add-btn:disabled {
      background: #8c9196;
      cursor: not-allowed;
    }
    .bt-fbt-savings-note {
      font-size: 0.85rem;
      color: #008060;
      font-weight: 600;
      text-align: center;
    }
  </style>

  <div
    class="bt-widget-container bt-fbt-widget"
    id="bt-fbt-widget-{{ block.id }}"
    data-base-variant-id="{{ base_variant.id }}"
    data-base-price="{{ base_price }}"
    data-base-discount="{{ main_disc_pct }}"
    data-discount-type="{{ matched_fbt_rule.discountType | default: 'PERCENTAGE' }}"
    data-discount-value="{{ fbt_val }}"
    data-code="{{ bundle_code }}"
    data-base-title="{{ product.title | escape }}"
    style="--bt-accent: {{ block.settings.accent_color | default: '#008060' }};"
  >
    <div class="bt-widget-header">
      <h3 class="bt-widget-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
        </svg>
        {{ block.settings.header_title | default: 'Frequently Bought Together' }}
      </h3>
      {% if block.settings.subtitle != blank %}
        <p class="bt-widget-subtitle">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Product Thumbnails Gallery -->
    <div class="bt-fbt-gallery">
      <!-- Main/Base Product (Current PDP) -->
      <div class="bt-fbt-thumb-card is-base">
        <div class="bt-fbt-thumb-wrap">
          {% if product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 160 }}"
              alt="{{ product.title | escape }}"
              class="bt-fbt-img"
              loading="lazy"
              width="80"
              height="80"
            >
          {% else %}
            <div class="bt-fbt-no-img">Product</div>
          {% endif %}
        </div>
        <span class="bt-fbt-thumb-label">This item</span>
        {% unless is_fixed_fbt %}
          {% if base_disc_pct > 0 %}
            <span class="bt-fbt-thumb-badge">-{{ base_disc_pct }}%</span>
          {% endif %}
        {% endunless %}
      </div>

      {% if is_current_trigger == false and matched_fbt_rule.triggerProduct %}
        {% assign trig = matched_fbt_rule.triggerProduct %}
        <div class="bt-fbt-plus-icon">+</div>
        <div class="bt-fbt-thumb-card" data-fbt-card-id="{{ trig.id }}">
          <div class="bt-fbt-thumb-wrap">
            {% if trig.image != blank %}
              <img
                src="{{ trig.image }}"
                alt="{{ trig.title | escape }}"
                class="bt-fbt-img"
                loading="lazy"
                width="80"
                height="80"
              >
            {% else %}
              <div class="bt-fbt-no-img">{{ trig.title | slice: 0, 10 }}</div>
            {% endif %}
          </div>
          {% unless is_fixed_fbt %}
            {% assign trig_disc = matched_fbt_rule.mainDiscountPercent | default: fbt_val %}
            {% if trig_disc > 0 %}
              <span class="bt-fbt-thumb-badge">-{{ trig_disc }}%</span>
            {% endif %}
          {% endunless %}
        </div>
      {% endif %}

      {% for fbt in matched_fbt_rule.fbtProducts %}
        {% assign fbt_id_str = fbt.productId | append: '' %}
        {% unless fbt_id_str contains current_product_id_str %}
          <div class="bt-fbt-plus-icon">+</div>
          <div class="bt-fbt-thumb-card" data-fbt-card-id="{{ fbt.productId }}">
            <div class="bt-fbt-thumb-wrap">
              {% if fbt.image != blank %}
                <img
                  src="{{ fbt.image }}"
                  alt="{{ fbt.title | escape }}"
                  class="bt-fbt-img"
                  loading="lazy"
                  width="80"
                  height="80"
                >
              {% else %}
                <div class="bt-fbt-no-img">{{ fbt.title | slice: 0, 10 }}</div>
              {% endif %}
            </div>
            {% unless is_fixed_fbt %}
              <span class="bt-fbt-thumb-badge">-{{ fbt.discountPercent | default: fbt_val }}%</span>
            {% endunless %}
          </div>
        {% endunless %}
      {% endfor %}
    </div>

    <!-- Product Selection Checkboxes -->
    <div class="bt-fbt-list">
      <!-- Base Product Checkbox (always locked/checked) -->
      <label class="bt-fbt-row is-base">
        <input type="checkbox" checked disabled class="bt-fbt-checkbox bt-fbt-base-checkbox">
        <span class="bt-fbt-check-label">
          <strong>This item:</strong> {{ product.title }}
          {% if is_fixed_fbt %}
            <span class="bt-fbt-save-pill">Part of Bundle</span>
          {% elsif base_disc_pct > 0 %}
            <span class="bt-fbt-save-pill">Save {{ base_disc_pct }}%</span>
          {% endif %}
        </span>
        <span class="bt-fbt-row-price">
          {% if is_fixed_fbt == false and base_disc_pct > 0 %}
            {% assign base_mult = 100 | minus: base_disc_pct %}
            {% assign base_disc_price = base_price | times: base_mult | divided_by: 100 %}
            <span class="bt-fbt-price-discounted">{{ base_disc_price | money }}</span>
            <span class="bt-fbt-price-original">{{ base_price | money }}</span>
          {% else %}
            {{ base_price | money }}
          {% endif %}
        </span>
      </label>

      {% if is_current_trigger == false and matched_fbt_rule.triggerProduct %}
        {% assign trig = matched_fbt_rule.triggerProduct %}
        {% assign trig_price_cents = trig.priceCents | default: 0 %}
        {% assign trig_disc_pct = matched_fbt_rule.mainDiscountPercent | default: fbt_val %}
        {% assign trig_disc_mult = 100 | minus: trig_disc_pct %}
        {% assign trig_disc_price = trig_price_cents | times: trig_disc_mult | divided_by: 100 %}

        <label class="bt-fbt-row">
          <input
            type="checkbox"
            checked
            class="bt-fbt-checkbox bt-fbt-companion-checkbox"
            data-product-id="{{ trig.id }}"
            data-variant-id="{{ trig.variantId }}"
            data-title="{{ trig.title | escape }}"
            data-price="{{ trig_price_cents }}"
            data-discount="{{ trig_disc_pct }}"
          >
          <span class="bt-fbt-check-label">
            {{ trig.title }}
            {% if is_fixed_fbt %}
              <span class="bt-fbt-save-pill">Part of Bundle</span>
            {% elsif trig_disc_pct > 0 %}
              <span class="bt-fbt-save-pill">Save {{ trig_disc_pct }}%</span>
            {% endif %}
          </span>
          <span class="bt-fbt-row-price">
            {% if is_fixed_fbt %}
              {{ trig_price_cents | money }}
            {% elsif trig_disc_pct > 0 %}
              <span class="bt-fbt-price-discounted">{{ trig_disc_price | money }}</span>
              <span class="bt-fbt-price-original">{{ trig_price_cents | money }}</span>
            {% else %}
              {{ trig_price_cents | money }}
            {% endif %}
          </span>
        </label>
      {% endif %}

      <!-- Companion Items Checkboxes -->
      {% for fbt in matched_fbt_rule.fbtProducts %}
        {% assign fbt_id_str = fbt.productId | append: '' %}
        {% unless fbt_id_str contains current_product_id_str %}
          {% assign fbt_price_cents = fbt.priceCents | default: 0 %}
          {% assign fbt_disc_pct = fbt.discountPercent | default: fbt_val %}
          {% assign disc_mult = 100 | minus: fbt_disc_pct %}
          {% assign fbt_disc_price = fbt_price_cents | times: disc_mult | divided_by: 100 %}

          <label class="bt-fbt-row">
            <input
              type="checkbox"
              checked
              class="bt-fbt-checkbox bt-fbt-companion-checkbox"
              data-product-id="{{ fbt.productId }}"
              data-variant-id="{{ fbt.variantId }}"
              data-title="{{ fbt.title | escape }}"
              data-price="{{ fbt_price_cents }}"
              data-discount="{{ fbt_disc_pct }}"
            >
            <span class="bt-fbt-check-label">
              {{ fbt.title }}
              {% if is_fixed_fbt %}
                <span class="bt-fbt-save-pill">Part of Bundle</span>
              {% elsif fbt_disc_pct > 0 %}
                <span class="bt-fbt-save-pill">Save {{ fbt_disc_pct }}%</span>
              {% endif %}
            </span>
            <span class="bt-fbt-row-price">
              {% if is_fixed_fbt %}
                {{ fbt_price_cents | money }}
              {% elsif fbt_price_cents > 0 %}
                <span class="bt-fbt-price-discounted">{{ fbt_disc_price | money }}</span>
                <span class="bt-fbt-price-original">{{ fbt_price_cents | money }}</span>
              {% else %}
                <span class="bt-fbt-price-discounted">-{{ fbt_disc_pct }}%</span>
              {% endif %}
            </span>
          </label>
        {% endunless %}
      {% endfor %}
    </div>

    <!-- Bundle Pricing & Add to Cart Action -->
    <div class="bt-fbt-summary-wrap">
      <div class="bt-fbt-total-box">
        <div class="bt-fbt-total-label">Bundle Price:</div>
        <div class="bt-fbt-pricing">
          <span class="bt-fbt-bundle-price">{{ initial_bundle_total | money }}</span>
          {% if initial_savings > 0 %}
            <span class="bt-fbt-bundle-compare">{{ initial_bundle_original | money }}</span>
          {% else %}
            <span class="bt-fbt-bundle-compare"></span>
          {% endif %}
        </div>
      </div>
      <button type="button" class="bt-fbt-add-btn">
        Add {{ total_items_count }} Items To Cart
      </button>
      <div class="bt-fbt-savings-note">
        {% if initial_savings > 0 %}
          Save {{ initial_savings | money }} with this bundle!
        {% endif %}
      </div>
    </div>

    <!-- Serialized FBT Config for JS -->
    <script type="application/json" class="bt-fbt-config">
      {
        "ruleId": {{ matched_fbt_rule.id | json }},
        "basePrice": {{ base_price }},
        "companions": [
          {% for fbt in matched_fbt_rule.fbtProducts %}
            {
              "productId": {{ fbt.productId | json }},
              "variantId": {{ fbt.variantId | json }},
              "title": {{ fbt.title | json }},
              "price": {{ fbt.priceCents | default: 0 }},
              "discountPercent": {{ fbt.discountPercent | default: 10 }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]
      }
    </script>
  </div>

  <script>
    window.__btRules = {{ config_data.rules | json }};
    try {
      if (window.__btRules && window.__btRules.length) {
        localStorage.setItem('__btRules', JSON.stringify(window.__btRules));
      }
    } catch (e) {}
  </script>
  <script src="{{ 'bundle-tier.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "FBT Bundle Widget",
  "target": "section",
  "templates": ["product"],
  "stylesheet": "bundle-tier.css",
  "javascript": "bundle-tier.js",
  "settings": [
    {
      "type": "text",
      "id": "header_title",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Get these items together and save"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#008060"
    }
  ]
}
{% endschema %}
