{% assign config_data = nil %}

{% if shop.metafields.app.bundle_tiers.config.value %}
  {% assign config_data = shop.metafields.app.bundle_tiers.config.value %}
{% elsif shop.metafields['$app:bundle_tiers']['config'].value %}
  {% assign config_data = shop.metafields['$app:bundle_tiers']['config'].value %}
{% elsif shop.metafields.bundle_tiers.config.value %}
  {% assign config_data = shop.metafields.bundle_tiers.config.value %}
{% elsif shop.metafields.app.bundle_tiers.config %}
  {% assign config_data = shop.metafields.app.bundle_tiers.config %}
{% elsif shop.metafields['$app:bundle_tiers']['config'] %}
  {% assign config_data = shop.metafields['$app:bundle_tiers']['config'] %}
{% elsif shop.metafields.bundle_tiers.config %}
  {% assign config_data = shop.metafields.bundle_tiers.config %}
{% endif %}

{% assign st = config_data.settings %}
{% assign widget_template = st.template | default: 'cards' %}
{% assign accent_color = st.accentColor | default: '#008060' %}
{% assign bg_color = st.bgColor | default: '#ffffff' %}
{% assign text_color = st.textColor | default: '#1a1a1a' %}
{% assign border_color = st.borderColor | default: '#e1e3e5' %}
{% assign badge_bg = st.badgeBg | default: '#008060' %}
{% assign badge_text = st.badgeText | default: '#ffffff' %}
{% assign font_size = st.fontSize | default: '15px' %}
{% assign border_radius = st.borderRadius | default: '8px' %}

{% assign current_product_id_str = product.id | append: '' %}
{% assign matched_product_volume_rule = nil %}
{% assign matched_collection_volume_rule = nil %}

{% if config_data and config_data.rules %}
  {% for rule in config_data.rules %}
    {% if rule.active and rule.tiers and rule.tiers.size > 0 %}
      {% assign target_str = rule.targetGid | append: '' %}
      {% if rule.targetType == 'PRODUCT' and target_str contains current_product_id_str and matched_product_volume_rule == nil %}
        {% assign matched_product_volume_rule = rule %}
      {% elsif rule.targetType == 'COLLECTION' and matched_collection_volume_rule == nil %}
        {% for collection in product.collections %}
          {% assign col_id_str = collection.id | append: '' %}
          {% if target_str contains col_id_str %}
            {% assign matched_collection_volume_rule = rule %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

{% assign has_volume_rule = false %}
{% if matched_product_volume_rule != nil or matched_collection_volume_rule != nil %}
  {% assign has_volume_rule = true %}
{% endif %}

{% if has_volume_rule %}
  <style>
    .bt-volume-widget {
      margin: 1.5rem 0;
      padding: 1.25rem;
      background: #ffffff;
      border: 1px solid #e1e3e5;
      border-radius: 12px;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #202223;
      box-sizing: border-box;
      width: 100%;
    }
    .bt-volume-widget * {
      box-sizing: border-box;
    }
    .bt-widget-header {
      margin-bottom: 1rem;
    }
    .bt-widget-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0 0 0.25rem 0;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: #1a1a1a;
    }
    .bt-widget-subtitle {
      font-size: 0.85rem;
      color: #6d7175;
      margin: 0;
    }
    .bt-tiers-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .bt-tier-card {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.85rem 1rem;
      border: 2px solid #e1e3e5;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      background: #fafbfb;
      user-select: none;
    }
    .bt-tier-card:hover {
      border-color: #008060;
      background: #f6fbf9;
    }
    .bt-tier-card.is-selected {
      border-color: #008060;
      background: #f0f8f5;
      box-shadow: 0 0 0 1px #008060;
    }
    .bt-tier-radio-wrap {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .bt-tier-radio {
      accent-color: #008060;
      width: 1.2rem;
      height: 1.2rem;
      cursor: pointer;
    }
    .bt-tier-info {
      display: flex;
      flex-direction: column;
    }
    .bt-tier-name {
      font-size: 0.95rem;
      font-weight: 600;
      color: #202223;
    }
    .bt-tier-per-item {
      font-size: 0.8rem;
      color: #6d7175;
    }
    .bt-tier-pricing {
      text-align: right;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }
    .bt-tier-price-current {
      font-size: 1rem;
      font-weight: 700;
      color: #008060;
    }
    .bt-tier-price-compare {
      font-size: 0.8rem;
      color: #8c9196;
      text-decoration: line-through;
    }
    .bt-tier-badge {
      position: absolute;
      top: -9px;
      right: 12px;
      background: #008060;
      color: #ffffff;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .bt-action-wrap {
      margin-top: 1rem;
    }
    .bt-add-btn {
      width: 100%;
      padding: 0.9rem 1.25rem;
      background: #008060;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.2s ease, transform 0.1s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    .bt-add-btn:hover {
      background: #006e52;
    }
    .bt-add-btn:active {
      transform: scale(0.99);
    }
    .bt-add-btn:disabled {
      background: #8c9196;
      cursor: not-allowed;
    }
    .bt-savings-summary {
      margin-top: 0.5rem;
      font-size: 0.85rem;
      text-align: center;
      color: #008060;
      font-weight: 600;
    }
  </style>

  <div
    class="bt-widget-container bt-volume-widget bt-template-{{ widget_template }}"
    id="bt-volume-widget-{{ block.id }}"
    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
    data-product-id="{{ product.id }}"
    style="
      --bt-accent: {{ accent_color }};
      --bt-bg: {{ bg_color }};
      --bt-text: {{ text_color }};
      --bt-border: {{ border_color }};
      --bt-badge-bg: {{ badge_bg }};
      --bt-badge-text: {{ badge_text }};
      --bt-font-size: {{ font_size }};
      --bt-radius: {{ border_radius }};
    "
  >
    <div class="bt-widget-header">
      <h3 class="bt-widget-title">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
          <line x1="7" y1="7" x2="7.01" y2="7"/>
        </svg>
        {{ block.settings.header_title | default: 'Buy More, Save More' }}
      </h3>
      {% if block.settings.subtitle != blank %}
        <p class="bt-widget-subtitle">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <!-- Volume Tiers Grid -->
    <div class="bt-tiers-list">
      {% assign base_price = product.selected_or_first_available_variant.price %}
      {% assign rendered_quantities = '' %}
      {% assign card_counter = 0 %}

      <!-- Render Product-level tiers first if present -->
      {% if matched_product_volume_rule != nil %}
        {% for tier in matched_product_volume_rule.tiers %}
          {% assign min_qty = tier.minQuantity | default: 1 %}
          {% assign is_fixed_tier = false %}
          {% if tier.discountType == 'FIXED_AMOUNT' %}
            {% assign is_fixed_tier = true %}
            {% assign tier_val = tier.discountValue | default: 100 %}
            {% assign fixed_amt = tier_val | times: 100 %}
            {% assign original_total = base_price | times: min_qty %}
            {% assign discounted_total = original_total | minus: fixed_amt %}
            {% if discounted_total < 0 %}{% assign discounted_total = 0 %}{% endif %}
            {% assign disc_pct = 0 %}
          {% else %}
            {% assign tier_val = tier.discountPercent | default: tier.discountValue | default: 10 %}
            {% assign disc_pct = tier_val %}
            {% assign original_total = base_price | times: min_qty %}
            {% assign discount_multiplier = 100 | minus: disc_pct %}
            {% assign discounted_total = original_total | times: discount_multiplier | divided_by: 100 %}
          {% endif %}
          {% assign per_item = discounted_total | divided_by: min_qty %}
          {% assign card_counter = card_counter | plus: 1 %}
          {% assign qty_key = ',' | append: min_qty | append: ',' %}
          {% assign rendered_quantities = rendered_quantities | append: qty_key %}

          {% assign clean_title = product.title | remove: 'Volume Tier:' | remove: 'Bundle for:' | strip %}
          {% assign clean_slug = clean_title | slice: 0, 8 | upcase %}
          {% assign tier_code = clean_slug | append: '-BUY' | append: min_qty | append: '-' | append: tier_val | append: 'OFF' %}

          <div
            class="bt-tier-card {% if card_counter == 1 %}is-selected{% endif %}"
            data-min-qty="{{ min_qty }}"
            data-discount-type="{{ tier.discountType | default: 'PERCENTAGE' }}"
            data-discount-value="{{ tier_val }}"
            data-discount="{{ disc_pct }}"
            data-code="{{ tier_code }}"
            data-label="{{ tier.label | default: '' }}"
          >
            {% if forloop.index == 2 and forloop.length > 2 %}
              <span class="bt-tier-badge">Most Popular</span>
            {% elsif forloop.last and matched_collection_volume_rule == nil and forloop.length > 2 %}
              <span class="bt-tier-badge">Best Value</span>
            {% endif %}

            <div class="bt-tier-radio-wrap">
              <input
                type="radio"
                name="bt-volume-tier-{{ block.id }}"
                class="bt-tier-radio"
                {% if card_counter == 1 %}checked{% endif %}
              >
              <div class="bt-tier-info">
                <span class="bt-tier-name">
                  Buy {{ min_qty }}
                  {% if is_fixed_tier %}
                    &middot; Save {{ fixed_amt | money }}
                  {% elsif disc_pct > 0 %}
                    &middot; Save {{ disc_pct }}%
                  {% endif %}
                </span>
                <span class="bt-tier-per-item">{{ per_item | money }}/each</span>
              </div>
            </div>

            <div class="bt-tier-pricing">
              <span class="bt-tier-price-current">{{ discounted_total | money }}</span>
              {% if is_fixed_tier or disc_pct > 0 %}
                <span class="bt-tier-price-compare">{{ original_total | money }}</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% endif %}

      <!-- Render Collection-level tiers if not duplicate -->
      {% if matched_collection_volume_rule != nil %}
        {% for tier in matched_collection_volume_rule.tiers %}
          {% assign min_qty = tier.minQuantity | default: 1 %}
          {% assign is_fixed_tier = false %}
          {% if tier.discountType == 'FIXED_AMOUNT' %}
            {% assign is_fixed_tier = true %}
            {% assign tier_val = tier.discountValue | default: 100 %}
            {% assign fixed_amt = tier_val | times: 100 %}
            {% assign original_total = base_price | times: min_qty %}
            {% assign discounted_total = original_total | minus: fixed_amt %}
            {% if discounted_total < 0 %}{% assign discounted_total = 0 %}{% endif %}
            {% assign disc_pct = 0 %}
          {% else %}
            {% assign tier_val = tier.discountPercent | default: tier.discountValue | default: 10 %}
            {% assign disc_pct = tier_val %}
            {% assign original_total = base_price | times: min_qty %}
            {% assign discount_multiplier = 100 | minus: disc_pct %}
            {% assign discounted_total = original_total | times: discount_multiplier | divided_by: 100 %}
          {% endif %}
          {% assign qty_key = ',' | append: min_qty | append: ',' %}

          {% unless rendered_quantities contains qty_key %}
            {% assign per_item = discounted_total | divided_by: min_qty %}
            {% assign card_counter = card_counter | plus: 1 %}

            {% assign clean_col_slug = collection.title | slice: 0, 8 | upcase %}
            {% assign tier_code = clean_col_slug | append: '-BUY' | append: min_qty | append: '-' | append: tier_val | append: 'OFF' %}

            <div
              class="bt-tier-card {% if card_counter == 1 %}is-selected{% endif %}"
              data-min-qty="{{ min_qty }}"
              data-discount-type="{{ tier.discountType | default: 'PERCENTAGE' }}"
              data-discount-value="{{ tier_val }}"
              data-discount="{{ disc_pct }}"
              data-code="{{ tier_code }}"
              data-label="{{ tier.label | default: '' }}"
            >
              <span class="bt-tier-badge">Best Value</span>

              <div class="bt-tier-radio-wrap">
                <input
                  type="radio"
                  name="bt-volume-tier-{{ block.id }}"
                  class="bt-tier-radio"
                  {% if card_counter == 1 %}checked{% endif %}
                >
                <div class="bt-tier-info">
                  <span class="bt-tier-name">
                    Buy {{ min_qty }}
                    {% if is_fixed_tier %}
                      &middot; Save {{ fixed_amt | money }}
                    {% elsif disc_pct > 0 %}
                      &middot; Save {{ disc_pct }}%
                    {% endif %}
                  </span>
                  <span class="bt-tier-per-item">{{ per_item | money }}/each</span>
                </div>
              </div>

              <div class="bt-tier-pricing">
                <span class="bt-tier-price-current">{{ discounted_total | money }}</span>
                {% if is_fixed_tier or disc_pct > 0 %}
                  <span class="bt-tier-price-compare">{{ original_total | money }}</span>
                {% endif %}
              </div>
            </div>
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>

    <!-- Single Add to Cart Button -->
    <div class="bt-action-wrap">
      <button type="button" class="bt-add-btn">
        Add To Cart
      </button>
      <div class="bt-savings-summary"></div>
    </div>

    <!-- Serialized Config for Javascript -->
    <script>
      window.__btRules = {{ config_data.rules | json }};
      try {
        if (window.__btRules && window.__btRules.length) {
          localStorage.setItem('__btRules', JSON.stringify(window.__btRules));
        }
      } catch (e) {}
    </script>
  </div>

  <script src="{{ 'bundle-tier.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Volume Discount Tiers",
  "target": "section",
  "templates": ["product"],
  "stylesheet": "bundle-tier.css",
  "javascript": "bundle-tier.js",
  "settings": [
    {
      "type": "text",
      "id": "header_title",
      "label": "Heading",
      "default": "Buy More, Save More"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Select a quantity bundle to unlock discounts"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#008060"
    }
  ]
}
{% endschema %}
